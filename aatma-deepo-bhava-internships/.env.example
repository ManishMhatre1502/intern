# Local development only. Never commit real credentials.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=aatma_deepo_bhava

# Generate the scrypt hash with npm run setup-admin locally.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD_HASH=scrypt$<32-hex-character-salt>$<128-hex-character-hash>

NODE_ENV=development

# Razorpay: create an order only on the server and verify payment signatures.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Resend sender must be verified before sending production email.
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Aatma Deepo Bhava <internships@example.com>
TASK_SUBMISSION_FORM_URL=https://forms.gle/replace-with-your-task-form

# Letter issuer identity. Set these to the client-approved organization details.
ORGANIZATION_NAME=Aatma Deepo Bhava
ORGANIZATION_WEBSITE=https://intern-free27.vercel.app
ORGANIZATION_CONTACT_EMAIL=internships@example.com
SIGNATORY_NAME=Program Administration
SIGNATORY_TITLE=Internship Program
GOOGLE_FORMS_WEBHOOK_SECRET=replace_me_with_a_long_random_secret
